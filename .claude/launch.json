{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "renderer-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dalliance/desktop",
        "exec",
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "desktop",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dalliance/web",
        "start"
      ],
      "port": 3100
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dalliance/web",
        "dev"
      ],
      "port": 3100
    },
    {
      "name": "cloud-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dalliance/cloud",
        "dev"
      ],
      "port": 3200
    }
  ]
}
