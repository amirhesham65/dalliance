# The site's public origin, used for canonical links, the sitemap and social cards
NEXT_PUBLIC_SITE_URL=https://dalliance.io
# Where /download sends people: the installer on the latest GitHub release
DALLIANCE_DOWNLOAD_URL=https://github.com/amirhesham65/dalliance/releases/latest/download/Dalliance.dmg
# Sign-in. The Convex deployment's HTTP actions URL, ending in .convex.site. /api/auth proxies to it
CONVEX_SITE_URL=
# The same value as AUTH_PROXY_SECRET on the Convex deployment. Convex turns away auth calls without it
AUTH_PROXY_SECRET=
# Sign-in methods the page offers, comma separated: github, google, password. Password is for local testing only
AUTH_METHODS=github,google
