# The Convex deployment's HTTP actions URL (ends in .convex.site). Better Auth and the gateway checks run there
CONVEX_SITE_URL=
# The same deployment's client URL (ends in .convex.cloud). /api/config tells the app, which follows the plan there
CONVEX_URL=
# Shared with the Convex deployment, which refuses auth and gateway calls that don't carry it. Generate with
# `openssl rand -base64 32` and set the same value on both sides
AUTH_PROXY_SECRET=
# Dalliance's own Vercel AI Gateway key. Users never see it: /api/ai spends it on their behalf
AI_GATEWAY_API_KEY=
# Which sign-in buttons to show. Must match the providers the Convex deployment has credentials for
AUTH_METHODS=github,google
