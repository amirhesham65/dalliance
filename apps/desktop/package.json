{
  "name": "@dalliance/desktop",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dist:mac": "rm -rf dist dist-electron && pnpm build && electron-builder --mac",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "oxlint -c ../../.oxlintrc.json"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.96",
    "@better-auth/electron": "catalog:",
    "@better-auth/utils": "catalog:",
    "@better-fetch/fetch": "catalog:",
    "@dalliance/shared": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "ai": "^7.0.118",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "convex": "catalog:",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "^4.14.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "catalog:"
  },
  "main": "dist-electron/main.js",
  "productName": "Dalliance",
  "description": "Dalliance: a notebook where each cell is written in plain language and turned into code.",
  "build": {
    "appId": "app.dalliance.desktop",
    "productName": "Dalliance",
    "copyright": "Copyright © 2026 Amir Hesham Ibrahim",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "protocols": [
      {
        "name": "Dalliance",
        "schemes": [
          "io.dalliance.app"
        ]
      }
    ],
    "files": [
      "dist/**",
      "dist-electron/**",
      "!node_modules/**"
    ],
    "fileAssociations": [
      {
        "ext": "ipynb",
        "name": "Jupyter Notebook",
        "description": "Jupyter Notebook",
        "mimeType": "application/x-ipynb+json",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}.${ext}",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Dalliance keeps new notebooks in Documents/Dalliance Notebooks."
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName}.${ext}"
    }
  }
}
