# Copy to .env for development. The app settings can hold the key instead.
AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=

# Point a development build at a Dalliance Cloud, like a local copy of the service. Unset, the app has no
# Dalliance Cloud and models run on the key above. See docs/cloud.md
# DALLIANCE_CLOUD_URL=http://localhost:3200
