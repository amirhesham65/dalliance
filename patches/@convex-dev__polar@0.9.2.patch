+// Patched: Polar endpoints made from 8 September 2026 sign with the Standard Webhooks key, the base64 after
+// whsec_. @polar-sh/sdk 0.x only knows the older key, the UTF-8 bytes of the whole secret, and 1.x can't be used
+// here. So when the older check fails, the signature is checked with the Standard Webhooks key, and only then is
+// the same body signed again under the older key, so the SDK parses it as before.
+function validatePolarEvent(body, headers, secret) {
+    try {
+        return validateEvent(body, headers, secret);
+    }
+    catch (error) {
+        if (!(error instanceof WebhookVerificationError) || !secret.startsWith("whsec_"))
+            throw error;
+        try {
+            new StandardWebhook(secret).verify(body, headers);
+        }
+        catch {
+            throw error;
+        }
+        const id = headers["webhook-id"];
+        const timestamp = new Date(Number(headers["webhook-timestamp"]) * 1000);
+        const legacy = new StandardWebhook(Buffer.from(secret, "utf-8").toString("base64"));
+        return validateEvent(body, { ...headers, "webhook-signature": legacy.sign(id, timestamp, body) }, secret);
+    }
+}
